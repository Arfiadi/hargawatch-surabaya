# Salin file ini jadi .env lalu isi nilai aslinya (jangan pernah commit .env ke git!)
# Kredensial ada di Supabase Dashboard -> Project Settings -> Database
# Gunakan connection pooler (port 6543) untuk script/aplikasi.

SUPABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xxxxxxxxxxxxx
SUPABASE_PASSWORD=password-anda-di-sini
