# Salin file ini jadi .env lalu isi nilai aslinya (jangan pernah commit .env ke git!)
# Kredensial ada di Supabase Dashboard -> Project Settings -> Database
# Gunakan connection pooler (port 6543) untuk script/aplikasi.

SUPABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xxxxxxxxxxxxx
SUPABASE_PASSWORD=password-anda-di-sini

# WebAPI BPS (untuk download_inflasi_bps.py) - registrasi gratis:
# https://webapi.bps.go.id/developer/
BPS_API_KEY=kunci-webapi-bps-anda

# 3. NOTIFIKASI & ALERTING TELEGRAM (Opsional)
# Buat bot via @BotFather di Telegram untuk mendapatkan token
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram_di_sini
# Dapatkan chat ID grup/pribadi via @userinfobot atau API getUpdates
TELEGRAM_CHAT_ID=isi_chat_id_telegram_di_sini

# 4. EXPERIMENT TRACKING & MODEL REGISTRY (Weights & Biases)
# Dapatkan API key di https://wandb.ai/authorize
W
